  capturedByMembershipId  String   @map("captured_by_membership_id") @db.Uuid
  capturedAt              DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payment   Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  file      File                  @relation(fields: [fileId], references: [id], onDelete: Restrict)
  capturedBy TenantStaffMembership @relation(fields: [capturedByMembershipId], references: [id], onDelete: Restrict)

  @@map("transfer_receipts")
}

