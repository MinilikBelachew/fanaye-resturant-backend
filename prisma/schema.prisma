  createdByMembershipId      String?  @map("created_by_membership_id") @db.Uuid
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch         Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  waiterShift    ShiftSession?           @relation(fields: [waiterShiftSessionId], references: [id], onDelete: Restrict)
  cashierSession CashierFinancialSession? @relation(fields: [cashierFinancialSessionId], references: [id], onDelete: Restrict)
  createdBy      TenantStaffMembership?  @relation(fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@map("cash_ledger_entries")
}

model CashierReconciliation {
  id                         String    @id @default(uuid()) @db.Uuid
  tenantId                   String    @map("tenant_id") @db.Uuid
  branchId                   String    @map("branch_id") @db.Uuid
  businessDate               DateTime  @map("business_date") @db.Date
  cashierFinancialSessionId  String    @unique @map("cashier_financial_session_id") @db.Uuid
  currencyCode               String    @default("ETB") @map("currency_code") @db.Char(3)
  expectedCashAmount         Decimal   @map("expected_cash_amount") @db.Decimal(19, 2)
  countedCashAmount          Decimal   @map("counted_cash_amount") @db.Decimal(19, 2)
  varianceAmount             Decimal   @map("variance_amount") @db.Decimal(19, 2)
  cashierComment             String?   @map("cashier_comment") @db.Text
  status                     String    @default("SUBMITTED") @db.VarChar(32)
  submittedAt                DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedByMembershipId     String?   @map("reviewed_by_membership_id") @db.Uuid
  reviewedAt                 DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewComment              String?   @map("review_comment") @db.Text
  version                    Int       @default(1)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashierSession CashierFinancialSession @relation(fields: [cashierFinancialSessionId], references: [id], onDelete: Restrict)
  reviewedBy     TenantStaffMembership? @relation(fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)

  @@map("cashier_reconciliations")
}

// =============================================================================
// Notifications, audit, operational daily close, idempotency
// =============================================================================

model Notification {
  id                          String    @id @default(uuid()) @db.Uuid
  tenantId                    String    @map("tenant_id") @db.Uuid
  branchId                    String?   @map("branch_id") @db.Uuid
  recipientStaffMembershipId  String    @map("recipient_staff_membership_id") @db.Uuid
  type                        String    @db.VarChar(60)
  severity                    String    @db.VarChar(20)
  relatedEntityType           String?   @map("related_entity_type") @db.VarChar(50)
  relatedEntityId             String?   @map("related_entity_id") @db.Uuid
  title                       String    @db.VarChar(180)
  body                        String?   @db.Text
  payloadJson                 Json?     @map("payload_json")
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt                      DateTime? @map("read_at") @db.Timestamptz(6)
  acknowledgedAt              DateTime? @map("acknowledged_at") @db.Timestamptz(6)

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch    Branch?               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  recipient TenantStaffMembership @relation(fields: [recipientStaffMembershipId], references: [id], onDelete: Restrict)

  @@map("notifications")
}

model AuditEvent {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String?   @map("tenant_id") @db.Uuid
  branchId                String?   @map("branch_id") @db.Uuid
  actorUserId             String?   @map("actor_user_id") @db.Uuid
  actorStaffMembershipId  String?   @map("actor_staff_membership_id") @db.Uuid
  actorPlatformRole       String?   @map("actor_platform_role") @db.VarChar(40)
  actorRestaurantRole     String?   @map("actor_restaurant_role") @db.VarChar(40)
  actorShiftSessionId     String?   @map("actor_shift_session_id") @db.Uuid
  supportSessionId        String?   @map("support_session_id") @db.Uuid
  entityType              String    @map("entity_type") @db.VarChar(60)
  entityId                String?   @map("entity_id") @db.Uuid
  action                  String    @db.VarChar(80)
  previousStateJson       Json?     @map("previous_state_json")
  newStateJson            Json?     @map("new_state_json")
  reason                  String?   @db.Text
  metadataJson            Json?     @map("metadata_json")
  correlationId           String?   @map("correlation_id") @db.Uuid
  idempotencyCommandId    String?   @map("idempotency_command_id") @db.Uuid
  occurredAt              DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant     Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch?                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actorUser  AppUser?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorStaff TenantStaffMembership? @relation(fields: [actorStaffMembershipId], references: [id], onDelete: SetNull)
  actorShift ShiftSession?          @relation(fields: [actorShiftSessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId, occurredAt(sort: Desc)], map: "ix_audit_events__entity")
  @@index([tenantId, actorStaffMembershipId, occurredAt(sort: Desc)], map: "ix_audit_events__actor")
  @@index([tenantId, branchId, occurredAt(sort: Desc)], map: "ix_audit_events__branch_time")
  @@map("audit_events")
}

model OperationalDailyClose {
  id                       String    @id @default(uuid()) @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  branchId                 String    @map("branch_id") @db.Uuid
  businessDate             DateTime  @map("business_date") @db.Date
  status                   String    @default("DRAFT") @db.VarChar(32)
  currencyCode             String    @default("ETB") @map("currency_code") @db.Char(3)
  generatedAt              DateTime  @default(now()) @map("generated_at") @db.Timestamptz(6)
  generatedByMembershipId  String    @map("generated_by_membership_id") @db.Uuid
  approvedAt               DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedByMembershipId   String?   @map("approved_by_membership_id") @db.Uuid
  lockedAt                 DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedByMembershipId     String?   @map("locked_by_membership_id") @db.Uuid
  grossOrderValue          Decimal   @map("gross_order_value") @db.Decimal(19, 2)
  cancelledValue           Decimal   @map("cancelled_value") @db.Decimal(19, 2)
  netBilledSales           Decimal   @map("net_billed_sales") @db.Decimal(19, 2)
  cashSales                Decimal   @map("cash_sales") @db.Decimal(19, 2)
  verifiedTransferSales    Decimal   @map("verified_transfer_sales") @db.Decimal(19, 2)
  pendingTransferAmount    Decimal   @map("pending_transfer_amount") @db.Decimal(19, 2)
  suspiciousTransferAmount Decimal   @map("suspicious_transfer_amount") @db.Decimal(19, 2)
  cashierExpectedCash      Decimal   @map("cashier_expected_cash") @db.Decimal(19, 2)
  cashierCountedCash       Decimal   @map("cashier_counted_cash") @db.Decimal(19, 2)
  cashierVariance          Decimal   @map("cashier_variance") @db.Decimal(19, 2)
  undroppedWaiterCash      Decimal   @map("undropped_waiter_cash") @db.Decimal(19, 2)
  tableCount               Int       @map("table_count")
  orderCount               Int       @map("order_count")
  itemCount                Int       @map("item_count")
  managerOverrideCount     Int       @map("manager_override_count")
  blockingIssuesJson       Json?     @map("blocking_issues_json")
  version                  Int       @default(1)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch      Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  generatedBy TenantStaffMembership @relation("DailyCloseGeneratedBy", fields: [generatedByMembershipId], references: [id], onDelete: Restrict)
  approvedBy  TenantStaffMembership? @relation("DailyCloseApprovedBy", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)
  lockedBy    TenantStaffMembership? @relation("DailyCloseLockedBy", fields: [lockedByMembershipId], references: [id], onDelete: SetNull)
  waiterLines DailyCloseWaiterLine[]
  stationLines DailyCloseStationLine[]

  @@unique([branchId, businessDate], map: "uq_operational_daily_closes__branch_business_date")
  @@map("operational_daily_closes")
}

model DailyCloseWaiterLine {
  id                               String  @id @default(uuid()) @db.Uuid
  tenantId                         String  @map("tenant_id") @db.Uuid
  dailyCloseId                     String  @map("daily_close_id") @db.Uuid
  waiterMembershipId               String  @map("waiter_membership_id") @db.Uuid
  shiftSessionId                   String  @map("shift_session_id") @db.Uuid
  ordersCreatedCount               Int     @map("orders_created_count")
  tablesServedCount                Int     @map("tables_served_count")
  grossAttributedSales             Decimal @map("gross_attributed_sales") @db.Decimal(19, 2)
  cancelledAttributedValue         Decimal @map("cancelled_attributed_value") @db.Decimal(19, 2)
  netAttributedSales               Decimal @map("net_attributed_sales") @db.Decimal(19, 2)
  cashCollected                    Decimal @map("cash_collected") @db.Decimal(19, 2)
  cashDropped                      Decimal @map("cash_dropped") @db.Decimal(19, 2)
  undroppedCash                    Decimal @map("undropped_cash") @db.Decimal(19, 2)
  verifiedTransferAmount           Decimal @map("verified_transfer_amount") @db.Decimal(19, 2)
  rejectedOrSuspiciousTransferCount Int    @map("rejected_or_suspicious_transfer_count")
  paymentExceptionCount            Int     @map("payment_exception_count")

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  close    OperationalDailyClose @relation(fields: [dailyCloseId], references: [id], onDelete: Restrict)
  waiter   TenantStaffMembership @relation(fields: [waiterMembershipId], references: [id], onDelete: Restrict)
  shift    ShiftSession          @relation(fields: [shiftSessionId], references: [id], onDelete: Restrict)

  @@unique([dailyCloseId, waiterMembershipId, shiftSessionId], map: "uq_daily_close_waiter_lines__waiter_shift")
  @@map("daily_close_waiter_lines")
}

model DailyCloseStationLine {
  id                          String  @id @default(uuid()) @db.Uuid
  tenantId                    String  @map("tenant_id") @db.Uuid
  dailyCloseId                String  @map("daily_close_id") @db.Uuid
  stationId                   String  @map("station_id") @db.Uuid
  stationNameSnapshot         String  @map("station_name_snapshot") @db.VarChar(120)
  itemsHandledCount           Int     @map("items_handled_count")
  averageQueueSeconds         Int?    @map("average_queue_seconds")
  averagePreparationSeconds   Int?    @map("average_preparation_seconds")
  averageReadyToServeSeconds  Int?    @map("average_ready_to_serve_seconds")
  delayedItemCount            Int     @map("delayed_item_count")
  cannotPrepareCount          Int     @map("cannot_prepare_count")

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  close   OperationalDailyClose @relation(fields: [dailyCloseId], references: [id], onDelete: Restrict)
  station PreparationStation    @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([dailyCloseId, stationId], map: "uq_daily_close_station_lines__station")
  @@map("daily_close_station_lines")
}

model IdempotencyCommand {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  actorUserId             String    @map("actor_user_id") @db.Uuid
  actorStaffMembershipId  String?   @map("actor_staff_membership_id") @db.Uuid
  commandType             String    @map("command_type") @db.VarChar(80)
  idempotencyKey          String    @map("idempotency_key") @db.VarChar(160)
  requestHash             String    @map("request_hash") @db.Char(64)
  status                  String    @db.VarChar(20)
  resourceType            String?   @map("resource_type") @db.VarChar(60)
  resourceId              String?   @map("resource_id") @db.Uuid
  responseStatusCode      Int?      @map("response_status_code")
  responseBodyJson        Json?     @map("response_body_json")
  startedAt               DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt             DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt               DateTime? @map("expires_at") @db.Timestamptz(6)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorUser  AppUser                @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorStaff TenantStaffMembership? @relation(fields: [actorStaffMembershipId], references: [id], onDelete: SetNull)

  @@unique([tenantId, actorUserId, commandType, idempotencyKey], map: "uq_idempotency_commands__actor_key")
  @@map("idempotency_commands")
}