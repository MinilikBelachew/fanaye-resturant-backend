  waiterShiftSessionId          String    @map("waiter_shift_session_id") @db.Uuid
  declaredAmount                Decimal   @map("declared_amount") @db.Decimal(19, 2)
  currencyCode                  String    @default("ETB") @map("currency_code") @db.Char(3)
  status                        String    @default("INITIATED") @db.VarChar(32)
  initiatedAt                   DateTime  @default(now()) @map("initiated_at") @db.Timestamptz(6)
  cashierFinancialSessionId     String?   @map("cashier_financial_session_id") @db.Uuid
