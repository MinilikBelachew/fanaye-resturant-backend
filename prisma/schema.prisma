  actorUser  AppUser                @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorStaff TenantStaffMembership? @relation(fields: [actorStaffMembershipId], references: [id], onDelete: SetNull)

  @@unique([tenantId, actorUserId, commandType, idempotencyKey], map: "uq_idempotency_commands__actor_key")
  @@map("idempotency_commands")
}

// =============================================================================
// Drivers — registered by owner, assigned to inventory transfers
// =============================================================================

/// Driver registered by the owner who can carry inventory transfers between locations.
model Driver {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  displayName              String   @map("display_name") @db.VarChar(160)
  phone                    String?  @db.VarChar(32)
  licencePlate             String?  @map("licence_plate") @db.VarChar(40)
  vehicleDesc              String?  @map("vehicle_desc") @db.VarChar(180)
  /// ACTIVE | INACTIVE
  status                   String   @default("ACTIVE") @db.VarChar(20)
  registeredByMembershipId String?  @map("registered_by_membership_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  registeredBy TenantStaffMembership? @relation("DriverRegisteredBy", fields: [registeredByMembershipId], references: [id], onDelete: SetNull)
  transfers    InventoryTransfer[]

  @@index([tenantId, status], map: "ix_drivers__tenant_status")
  @@map("drivers")
}

// =============================================================================
// Inventory — tenant catalog + location stock + transfers / production
// =============================================================================

model Vendor {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  /// FARM | NEGADE | OTHER
  type                  String   @db.VarChar(20)
  name                  String   @db.VarChar(160)
  contactPerson         String?  @map("contact_person") @db.VarChar(160)
  phone                 String?  @db.VarChar(32)
  address               String?  @db.VarChar(180)
  /// ACTIVE | INACTIVE
  status                String   @default("ACTIVE") @db.VarChar(20)
  createdByMembershipId String?  @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy     TenantStaffMembership? @relation("VendorCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  ledgerEntries InventoryLedgerEntry[]

  @@index([tenantId, status], map: "ix_vendors__tenant_status")
  @@map("vendors")
}

model InventoryUnit {
  id        String   @id @default(uuid()) @db.Uuid
  /// Null = built-in global unit shared by all tenants; set = tenant custom unit.
  tenantId  String?  @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(20)
  name      String   @db.VarChar(80)
  /// weight | volume | count | pack
  category  String   @db.VarChar(40)
  sortOrder Int      @default(0) @map("sort_order")
  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code], map: "uq_inventory_units__tenant_code")
  @@index([status, sortOrder], map: "ix_inventory_units__status_sort")
  @@index([tenantId], map: "ix_inventory_units__tenant")
  @@map("inventory_units")
}

/// Tenant-defined unit conversion pair, e.g. "3 bottle = 1 jar" (from bottle, to jar, factor 3).
model InventoryUnitConversion {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  fromUnit              String   @map("from_unit") @db.VarChar(20)
  toUnit                String   @map("to_unit") @db.VarChar(20)
  /// How many fromUnit make one toUnit.
  factor                Decimal  @db.Decimal(19, 4)
  status                String   @default("ACTIVE") @db.VarChar(20)
  createdByMembershipId String?  @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy TenantStaffMembership? @relation("UnitConversionCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@unique([tenantId, fromUnit, toUnit], map: "uq_inventory_unit_conversions__tenant_pair")
  @@index([tenantId, status], map: "ix_inventory_unit_conversions__tenant_status")
  @@map("inventory_unit_conversions")
}

/// Stock location: main warehouse, branch store, or shared store.
model InventoryLocation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Branch this store serves (null only for unattached MAIN if needed).
  branchId  String?  @map("branch_id") @db.Uuid
  code      String   @db.VarChar(40)
  name      String   @db.VarChar(120)
  /// MAIN_WAREHOUSE | BRANCH_STORE | SHARED_STORE
  type      String   @db.VarChar(40)
  isDefault Boolean  @default(false) @map("is_default")
  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch             Branch?                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  balances           InventoryStockBalance[]
  ledgerEntries      InventoryLedgerEntry[]
  countSessions      InventoryCountSession[]
  materialBalances   InventoryMaterialBalance[]
  transfersFrom      InventoryTransfer[]        @relation("TransferFromLocation")
  transfersTo        InventoryTransfer[]        @relation("TransferToLocation")
  supplyRequestsFrom InventorySupplyRequest[]   @relation("SupplyFromLocation")
  supplyRequestsTo   InventorySupplyRequest[]   @relation("SupplyToLocation")
  productionBatches  InventoryProductionBatch[]
  yieldTests         InventoryYieldTest[]
  pushDropsFrom      InventoryPushDrop[]

  @@unique([tenantId, code], map: "uq_inventory_locations__tenant_code")
  @@index([tenantId, type, status], map: "ix_inventory_locations__tenant_type")
  @@index([branchId], map: "ix_inventory_locations__branch")
  @@map("inventory_locations")
}

model InventoryCategory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  name        String   @db.VarChar(120)
  amharicName String?  @map("amharic_name") @db.VarChar(120)
  code        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items  InventoryIngredient[]

  @@unique([tenantId, code], map: "uq_inventory_categories__tenant_code")
  @@index([tenantId, status], map: "ix_inventory_categories__tenant_status")
  @@index([tenantId, branchId], map: "ix_inventory_categories__tenant_branch")
  @@map("inventory_categories")
}

/// Tenant-wide item catalog (raw / produced / finished). branchId optional legacy.
model InventoryIngredient {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  /// Legacy home branch; null = pure tenant catalog item.
  branchId             String?  @map("branch_id") @db.Uuid
  categoryId           String?  @map("category_id") @db.Uuid
  name                 String   @db.VarChar(180)
  unit                 String   @db.VarChar(20)
  /// RAW | PRODUCED | FINISHED
  itemKind             String   @default("RAW") @map("item_kind") @db.VarChar(20)
  unitCost             Decimal  @default(0) @map("unit_cost") @db.Decimal(19, 4)
  /// Last AP→EP yield % from production (e.g. onion 80). Null = unknown.
  standardYieldPercent Decimal? @map("standard_yield_percent") @db.Decimal(8, 2)
  parLevel             Decimal  @default(0) @map("par_level") @db.Decimal(19, 4)
  status               String   @default("ACTIVE") @db.VarChar(20)
  imageUrl             String?  @map("image_url") @db.VarChar(512)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch             Branch?                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  category           InventoryCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  balances           InventoryStockBalance[]
  recipeLines        MenuItemRecipeLine[]
  ledgerEntries      InventoryLedgerEntry[]
  countLines         InventoryCountLine[]
  transferLines      InventoryTransferLine[]
  supplyRequestLines InventorySupplyRequestLine[]
  productionOutputs  InventoryProductionBatch[]   @relation("ProductionOutput")
  productionInputs   InventoryProductionInput[]
  yieldTests         InventoryYieldTest[]

  @@unique([tenantId, name], map: "uq_inventory_ingredients__tenant_name")
  @@index([tenantId, status], map: "ix_inventory_ingredients__tenant_status")
  @@index([tenantId, branchId, status], map: "ix_inventory_ingredients__branch_status")
  @@index([tenantId, categoryId], map: "ix_inventory_ingredients__tenant_category")
  @@map("inventory_ingredients")
}

/// Registered AP→EP yield tests (one row per test; ingredient.standardYieldPercent = latest).
model InventoryYieldTest {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  locationId           String?  @map("location_id") @db.Uuid
  ingredientId         String   @map("ingredient_id") @db.Uuid
  purchasedQuantity    Decimal  @map("purchased_quantity") @db.Decimal(19, 4)
  usableQuantity       Decimal  @map("usable_quantity") @db.Decimal(19, 4)
  trimQuantity         Decimal  @default(0) @map("trim_quantity") @db.Decimal(19, 4)
  yieldPercent         Decimal  @map("yield_percent") @db.Decimal(8, 2)
  apUnitCost           Decimal  @default(0) @map("ap_unit_cost") @db.Decimal(19, 4)
  epUnitCost           Decimal  @default(0) @map("ep_unit_cost") @db.Decimal(19, 4)
  /// Unit purchased/usable were entered in; null = ingredient's stock unit.
  unit                 String?  @db.VarChar(20)
  wroteOffTrim         Boolean  @default(false) @map("wrote_off_trim")
  note                 String?  @db.VarChar(255)
  postedByMembershipId String?  @map("posted_by_membership_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location   InventoryLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  ingredient InventoryIngredient    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  postedBy   TenantStaffMembership? @relation("YieldTestPostedBy", fields: [postedByMembershipId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt], map: "ix_inventory_yield_tests__tenant_created")
  @@index([tenantId, ingredientId], map: "ix_inventory_yield_tests__ingredient")
  @@map("inventory_yield_tests")
}

model InventoryStockBalance {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  /// Required for new rows; backfilled for legacy balances.
  locationId   String?  @map("location_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  onHandQty    Decimal  @default(0) @map("on_hand_qty") @db.Decimal(19, 4)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  location   InventoryLocation?  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  ingredient InventoryIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([locationId, ingredientId], map: "uq_inventory_stock_balances__location_ingredient")
  @@index([tenantId, locationId], map: "ix_inventory_stock_balances__location")
  @@index([tenantId, branchId], map: "ix_inventory_stock_balances__branch")
  @@index([ingredientId], map: "ix_inventory_stock_balances__ingredient")
  @@map("inventory_stock_balances")
}

model InventoryTransfer {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  fromLocationId         String    @map("from_location_id") @db.Uuid
  toLocationId           String    @map("to_location_id") @db.Uuid
  /// DRAFT | PENDING_APPROVAL | APPROVED | IN_TRANSIT | RECEIVED | REJECTED | CANCELLED
  status                 String    @default("DRAFT") @db.VarChar(24)
  note                   String?   @db.VarChar(255)
  supplyRequestId        String?   @unique @map("supply_request_id") @db.Uuid
  pushDropId             String?   @map("push_drop_id") @db.Uuid
  driverId               String?   @map("driver_id") @db.Uuid
  sentByMembershipId     String?   @map("sent_by_membership_id") @db.Uuid
  receivedByMembershipId String?   @map("received_by_membership_id") @db.Uuid
  dispatchedAt           DateTime? @map("dispatched_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt                 DateTime? @map("sent_at") @db.Timestamptz(6)
  receivedAt             DateTime? @map("received_at") @db.Timestamptz(6)

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fromLocation  InventoryLocation       @relation("TransferFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation    InventoryLocation       @relation("TransferToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  supplyRequest InventorySupplyRequest? @relation(fields: [supplyRequestId], references: [id], onDelete: SetNull)
  pushDrop      InventoryPushDrop?      @relation(fields: [pushDropId], references: [id], onDelete: SetNull)
  driver        Driver?                 @relation(fields: [driverId], references: [id], onDelete: SetNull)
  sentBy        TenantStaffMembership?  @relation("TransferSentBy", fields: [sentByMembershipId], references: [id], onDelete: SetNull)
  receivedBy    TenantStaffMembership?  @relation("TransferReceivedBy", fields: [receivedByMembershipId], references: [id], onDelete: SetNull)
  lines         InventoryTransferLine[]

  @@index([tenantId, status, createdAt], map: "ix_inventory_transfers__tenant_status")
  @@index([driverId, status], map: "ix_inventory_transfers__driver_status")
  @@map("inventory_transfers")
}

model InventoryTransferLine {
  id               String   @id @default(uuid()) @db.Uuid
  transferId       String   @map("transfer_id") @db.Uuid
  ingredientId     String   @map("ingredient_id") @db.Uuid
  quantitySent     Decimal  @map("quantity_sent") @db.Decimal(19, 4)
  /// Unit quantitySent was entered in; null = ingredient's stock unit.
  unitSent         String?  @map("unit_sent") @db.VarChar(20)
  quantityReceived Decimal? @map("quantity_received") @db.Decimal(19, 4)

  transfer   InventoryTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  ingredient InventoryIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([transferId], map: "ix_inventory_transfer_lines__transfer")
  @@map("inventory_transfer_lines")
}

model InventorySupplyRequest {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  /// Branch store asking
  fromLocationId          String    @map("from_location_id") @db.Uuid
  /// Usually main warehouse
  toLocationId            String    @map("to_location_id") @db.Uuid
  /// DRAFT | SUBMITTED | PENDING_APPROVAL | APPROVED | REJECTED | FULFILLED | CANCELLED
  status                  String    @default("DRAFT") @db.VarChar(24)
  /// When true the request is auto-approved and goes straight to the storekeeper
  autoApprove             Boolean   @default(false) @map("auto_approve")
  note                    String?   @db.VarChar(255)
  decisionNote            String?   @map("decision_note") @db.VarChar(255)
  requestedByMembershipId String?   @map("requested_by_membership_id") @db.Uuid
  decidedByMembershipId   String?   @map("decided_by_membership_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt             DateTime? @map("submitted_at") @db.Timestamptz(6)
  decidedAt               DateTime? @map("decided_at") @db.Timestamptz(6)

  tenant       Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fromLocation InventoryLocation            @relation("SupplyFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   InventoryLocation            @relation("SupplyToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  requestedBy  TenantStaffMembership?       @relation("SupplyRequestedBy", fields: [requestedByMembershipId], references: [id], onDelete: SetNull)
  decidedBy    TenantStaffMembership?       @relation("SupplyDecidedBy", fields: [decidedByMembershipId], references: [id], onDelete: SetNull)
  lines        InventorySupplyRequestLine[]
  transfer     InventoryTransfer?

  @@index([tenantId, status, createdAt], map: "ix_inventory_supply_requests__tenant_status")
  @@map("inventory_supply_requests")
}

model InventorySupplyRequestLine {
  id                String  @id @default(uuid()) @db.Uuid
  supplyRequestId   String  @map("supply_request_id") @db.Uuid
  ingredientId      String  @map("ingredient_id") @db.Uuid
  quantityRequested Decimal @map("quantity_requested") @db.Decimal(19, 4)
  /// Unit quantityRequested was entered in; null = ingredient's stock unit.
  unit              String? @db.VarChar(20)

  supplyRequest InventorySupplyRequest @relation(fields: [supplyRequestId], references: [id], onDelete: Cascade)
  ingredient    InventoryIngredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([supplyRequestId], map: "ix_inventory_supply_request_lines__request")
  @@map("inventory_supply_request_lines")
}

/// Storekeeper-initiated scheduled weekly push/drop to one or more branches.
model InventoryPushDrop {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  fromLocationId        String    @map("from_location_id") @db.Uuid
  /// DRAFT | DISPATCHED | PARTIAL | COMPLETED | CANCELLED
  status                String    @default("DRAFT") @db.VarChar(20)
  label                 String?   @db.VarChar(180)
  note                  String?   @db.VarChar(255)
  scheduledDate         DateTime? @map("scheduled_date") @db.Date
  createdByMembershipId String?   @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fromLocation InventoryLocation      @relation(fields: [fromLocationId], references: [id], onDelete: Restrict)
  createdBy    TenantStaffMembership? @relation("PushDropCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  transfers    InventoryTransfer[]

  @@index([tenantId, status, createdAt], map: "ix_inventory_push_drops__tenant_status")
  @@map("inventory_push_drops")
}

model InventoryProductionBatch {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  locationId             String   @map("location_id") @db.Uuid
  outputIngredientId     String   @map("output_ingredient_id") @db.Uuid
  outputQuantity         Decimal  @map("output_quantity") @db.Decimal(19, 4)
  /// Unit outputQuantity was entered in; null = output ingredient's stock unit.
  outputUnit             String?  @map("output_unit") @db.VarChar(20)
  /// Optional target output for yield test (actual ÷ expected).
  expectedOutputQuantity Decimal? @map("expected_output_quantity") @db.Decimal(19, 4)
  /// Yield % for this batch (0–100).
  yieldPercent           Decimal? @map("yield_percent") @db.Decimal(8, 2)
  inputCostTotal         Decimal  @default(0) @map("input_cost_total") @db.Decimal(19, 4)
  outputUnitCost         Decimal  @default(0) @map("output_unit_cost") @db.Decimal(19, 4)
  note                   String?  @db.VarChar(255)
  postedByMembershipId   String?  @map("posted_by_membership_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location         InventoryLocation          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  outputIngredient InventoryIngredient        @relation("ProductionOutput", fields: [outputIngredientId], references: [id], onDelete: Restrict)
  postedBy         TenantStaffMembership?     @relation("ProductionPostedBy", fields: [postedByMembershipId], references: [id], onDelete: SetNull)
  inputs           InventoryProductionInput[]

  @@index([tenantId, locationId, createdAt], map: "ix_inventory_production_batches__location")
  @@map("inventory_production_batches")
}

model InventoryProductionInput {
  id           String  @id @default(uuid()) @db.Uuid
  batchId      String  @map("batch_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  quantity     Decimal @db.Decimal(19, 4)
  /// Unit quantity was entered in; null = ingredient's stock unit.
  unit         String? @db.VarChar(20)

  batch      InventoryProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  ingredient InventoryIngredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([batchId], map: "ix_inventory_production_inputs__batch")
  @@map("inventory_production_inputs")
}

model MenuItemRecipeLine {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  menuItemId         String  @map("menu_item_id") @db.Uuid
  ingredientId       String  @map("ingredient_id") @db.Uuid
  quantityPerServing Decimal @map("quantity_per_serving") @db.Decimal(19, 4)
  /// Unit of quantityPerServing; null = ingredient's stock unit.
  unit               String? @db.VarChar(20)
  sortOrder          Int     @default(0) @map("sort_order")

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  menuItem   MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient InventoryIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, ingredientId], map: "uq_menu_item_recipe_lines__item_ingredient")
  @@index([tenantId, menuItemId], map: "ix_menu_item_recipe_lines__item")
  @@map("menu_item_recipe_lines")
}

model InventoryLedgerEntry {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  branchId              String?  @map("branch_id") @db.Uuid
  locationId            String?  @map("location_id") @db.Uuid
  ingredientId          String   @map("ingredient_id") @db.Uuid
  entryType             String   @map("entry_type") @db.VarChar(40)
  quantityDelta         Decimal  @map("quantity_delta") @db.Decimal(19, 4)
  unitCostSnapshot      Decimal? @map("unit_cost_snapshot") @db.Decimal(19, 4)
  note                  String?  @db.VarChar(255)
  supplierNote          String?  @map("supplier_note") @db.VarChar(180)
  invoiceRef            String?  @map("invoice_ref") @db.VarChar(80)
  orderItemId           String?  @map("order_item_id") @db.Uuid
  countSessionId        String?  @map("count_session_id") @db.Uuid
  transferId            String?  @map("transfer_id") @db.Uuid
  productionBatchId     String?  @map("production_batch_id") @db.Uuid
  vendorId              String?  @map("vendor_id") @db.Uuid
  createdByMembershipId String?  @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch?                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  location     InventoryLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  ingredient   InventoryIngredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  orderItem    OrderItem?             @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  countSession InventoryCountSession? @relation(fields: [countSessionId], references: [id], onDelete: SetNull)
  vendor       Vendor?                @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdBy    TenantStaffMembership? @relation(fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, createdAt], map: "ix_inventory_ledger__branch_created")
  @@index([tenantId, locationId, createdAt], map: "ix_inventory_ledger__location_created")
  @@index([ingredientId, createdAt], map: "ix_inventory_ledger__ingredient_created")
  @@index([orderItemId], map: "ix_inventory_ledger__order_item")
  @@index([vendorId], map: "ix_inventory_ledger__vendor")
  @@index([entryType], map: "ix_inventory_ledger__type")
  @@map("inventory_ledger_entries")
}

model InventoryCountSession {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  branchId              String    @map("branch_id") @db.Uuid
  locationId            String?   @map("location_id") @db.Uuid
  status                String    @default("DRAFT") @db.VarChar(20)
  notes                 String?   @db.VarChar(255)
  createdByMembershipId String?   @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt              DateTime? @map("posted_at") @db.Timestamptz(6)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch        Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  location      InventoryLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy     TenantStaffMembership? @relation(fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  lines         InventoryCountLine[]
  ledgerEntries InventoryLedgerEntry[]

  @@index([tenantId, branchId, status], map: "ix_inventory_count_sessions__branch_status")
  @@map("inventory_count_sessions")
}

model InventoryCountLine {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  countSessionId  String   @map("count_session_id") @db.Uuid
  ingredientId    String   @map("ingredient_id") @db.Uuid
  bookQtySnapshot Decimal  @map("book_qty_snapshot") @db.Decimal(19, 4)
  countedQty      Decimal? @map("counted_qty") @db.Decimal(19, 4)
  /// Unit countedQty was entered in; null = ingredient's stock unit.
  countedUnit     String?  @map("counted_unit") @db.VarChar(20)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  countSession InventoryCountSession @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  ingredient   InventoryIngredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([countSessionId, ingredientId], map: "uq_inventory_count_lines__session_ingredient")
  @@index([tenantId, countSessionId], map: "ix_inventory_count_lines__session")
  @@map("inventory_count_lines")
}

// =============================================================================
// Guest feedback / ratings (QR table menu + public restaurant website)
// =============================================================================

model CustomerFeedback {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  branchId               String    @map("branch_id") @db.Uuid
  /// Set for table QR submissions; null for website submissions.
  tableId                String?   @map("table_id") @db.Uuid
  tableSessionId         String?   @map("table_session_id") @db.Uuid
  outsideOrderId         String?   @map("outside_order_id") @db.Uuid
  orderId                String?   @map("order_id") @db.Uuid
  /// QR_MENU | WEBSITE
  source                 String    @default("QR_MENU") @map("source") @db.VarChar(20)
  rating                 Int
  comment                String?   @db.Text
  customerName           String?   @map("customer_name") @db.VarChar(120)
  customerPhone          String?   @map("customer_phone") @db.VarChar(40)
  /// NEW | READ | RESOLVED
  status                 String    @default("NEW") @map("status") @db.VarChar(20)
  resolvedByMembershipId String?   @map("resolved_by_membership_id") @db.Uuid
  resolvedAt             DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table        DiningTable?           @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSession TableSession?          @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  outsideOrder OutsideOrder?          @relation(fields: [outsideOrderId], references: [id], onDelete: SetNull)
  order        Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  resolvedBy   TenantStaffMembership? @relation("CustomerFeedbackResolvedBy", fields: [resolvedByMembershipId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, createdAt], map: "ix_customer_feedback__branch_created")
  @@index([tenantId, status], map: "ix_customer_feedback__tenant_status")
  @@index([tableSessionId], map: "ix_customer_feedback__session")
  @@map("customer_feedback")
}

// =============================================================================
// Outside orders (food leaves the premises) + returnable materials
// =============================================================================

/// Third order container alongside TableSession / RoomSession: no dining table,
/// destination is off-premises (next building, cafe, kiosk).
model OutsideOrder {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  branchId               String    @map("branch_id") @db.Uuid
  businessDate           DateTime  @map("business_date") @db.Date
  /// BUILDING | CAFE | KIOSK | OTHER
  destinationType        String    @default("OTHER") @map("destination_type") @db.VarChar(24)
  destinationName        String    @map("destination_name") @db.VarChar(180)
  destinationNote        String?   @map("destination_note") @db.Text
  customerName           String?   @map("customer_name") @db.VarChar(120)
  customerPhone          String?   @map("customer_phone") @db.VarChar(40)
  createdByMembershipId  String    @map("created_by_membership_id") @db.Uuid
  waiterShiftSessionId   String    @map("waiter_shift_session_id") @db.Uuid
  /// Materials handed out on this order must come back.
  requiresMaterialReturn Boolean   @default(true) @map("requires_material_return")
  /// OPEN | ACTIVE_ORDER | BILL_REQUESTED | BILL_READY | CLOSED
  status                 String    @default("OPEN") @db.VarChar(32)
  openedAt               DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt               DateTime? @map("closed_at") @db.Timestamptz(6)
  closedByMembershipId   String?   @map("closed_by_membership_id") @db.Uuid
  version                Int       @default(1)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy      TenantStaffMembership  @relation("OutsideOrderCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  closedBy       TenantStaffMembership? @relation("OutsideOrderClosedBy", fields: [closedByMembershipId], references: [id], onDelete: SetNull)
  shift          ShiftSession           @relation(fields: [waiterShiftSessionId], references: [id], onDelete: Restrict)
  orders         Order[]
  items          OrderItem[]
  billRequests   BillRequest[]
  bills          Bill[]
  feedback       CustomerFeedback[]

  @@index([tenantId, branchId, businessDate, openedAt], map: "ix_outside_orders__branch_date")
  @@index([branchId, status], map: "ix_outside_orders__branch_status")
  @@map("outside_orders")
}

/// Reusable material catalog (cutlery, trays, carriers, packaging...).
/// Separate from InventoryIngredient because materials come back.
model InventoryMaterial {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(160)
  amharicName String?  @map("amharic_name") @db.VarChar(160)
  code        String   @db.VarChar(60)
  /// CUTLERY | CROCKERY | TRAYS_CARRIERS | PACKAGING | LINEN | CLEANING | EQUIPMENT
  category    String   @default("OTHER") @db.VarChar(40)
  unit        String   @default("pcs") @db.VarChar(24)
  /// When true the item is expected back after an outside order.
  isReusable  Boolean  @default(true) @map("is_reusable")
  imageUrl    String?  @map("image_url") @db.VarChar(400)
  description String?  @db.VarChar(400)
  sortOrder   Int      @default(0) @map("sort_order")
  /// ACTIVE | INACTIVE | ARCHIVED
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  balances   InventoryMaterialBalance[]
  issueLines OrderMaterialIssueLine[]

  @@unique([tenantId, code], map: "uq_inventory_materials__tenant_code")
  @@index([tenantId, category, status], map: "ix_inventory_materials__tenant_category")
  @@map("inventory_materials")
}

/// Per-location material stock: onHand = in store, issued = out with a waiter.
model InventoryMaterialBalance {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  locationId String?  @map("location_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  onHandQty  Decimal  @default(0) @map("on_hand_qty") @db.Decimal(14, 3)
  issuedQty  Decimal  @default(0) @map("issued_qty") @db.Decimal(14, 3)
  lostQty    Decimal  @default(0) @map("lost_qty") @db.Decimal(14, 3)
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch   Branch?            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  location InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  material InventoryMaterial  @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([locationId, materialId], map: "uq_inventory_material_balances__location_material")
  @@index([tenantId, materialId], map: "ix_inventory_material_balances__tenant_material")
  @@map("inventory_material_balances")
}

/// Chef issues materials for an order; the waiter returns them; the chef approves.
model OrderMaterialIssue {
  id                         String    @id @default(uuid()) @db.Uuid
  tenantId                   String    @map("tenant_id") @db.Uuid
  branchId                   String    @map("branch_id") @db.Uuid
  businessDate               DateTime  @map("business_date") @db.Date
  orderId                    String    @map("order_id") @db.Uuid
  issuedByChefMembershipId   String    @map("issued_by_chef_membership_id") @db.Uuid
  waiterMembershipId         String    @map("waiter_membership_id") @db.Uuid
  waiterShiftSessionId       String    @map("waiter_shift_session_id") @db.Uuid
  /// PENDING | ISSUED | RETURNED | APPROVED | DISPUTED | CANCELLED
  status                     String    @default("PENDING") @db.VarChar(24)
  note                       String?   @db.Text
  issuedAt                   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  acknowledgedAt             DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  returnedAt                 DateTime? @map("returned_at") @db.Timestamptz(6)
  approvedByChefMembershipId String?   @map("approved_by_chef_membership_id") @db.Uuid
  approvedAt                 DateTime? @map("approved_at") @db.Timestamptz(6)
  disputeReason              String?   @map("dispute_reason") @db.Text
  version                    Int       @default(1)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch         Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order          Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  issuedBy       TenantStaffMembership    @relation("MaterialIssueIssuedBy", fields: [issuedByChefMembershipId], references: [id], onDelete: Restrict)
  waiter         TenantStaffMembership    @relation("MaterialIssueWaiter", fields: [waiterMembershipId], references: [id], onDelete: Restrict)
  shift          ShiftSession             @relation(fields: [waiterShiftSessionId], references: [id], onDelete: Restrict)
  approvedBy     TenantStaffMembership?   @relation("MaterialIssueApprovedBy", fields: [approvedByChefMembershipId], references: [id], onDelete: SetNull)
  lines          OrderMaterialIssueLine[]

  @@index([tenantId, orderId], map: "ix_order_material_issues__order")
  @@index([tenantId, branchId, status], map: "ix_order_material_issues__branch_status")
  @@index([tenantId, waiterMembershipId, status], map: "ix_order_material_issues__waiter_status")
  @@map("order_material_issues")
}

model OrderMaterialIssueLine {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  issueId              String   @map("issue_id") @db.Uuid
  materialId           String   @map("material_id") @db.Uuid
  materialNameSnapshot String   @map("material_name_snapshot") @db.VarChar(160)
  qtyIssued            Decimal  @map("qty_issued") @db.Decimal(14, 3)
  qtyReturned          Decimal  @default(0) @map("qty_returned") @db.Decimal(14, 3)
  qtyShortfall         Decimal  @default(0) @map("qty_shortfall") @db.Decimal(14, 3)
  /// OK | DAMAGED | MISSING
  condition            String   @default("OK") @db.VarChar(16)
  note                 String?  @db.VarChar(400)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  issue    OrderMaterialIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  material InventoryMaterial  @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([issueId], map: "ix_order_material_issue_lines__issue")
  @@map("order_material_issue_lines")
}
