// Live floor: table visit + confirmed orders
// =============================================================================

model TableSession {
  id                          String    @id @default(uuid()) @db.Uuid
  tenantId                    String    @map("tenant_id") @db.Uuid
  branchId                    String    @map("branch_id") @db.Uuid
  tableId                     String    @map("table_id") @db.Uuid
  businessDate                DateTime  @map("business_date") @db.Date
  primaryWaiterMembershipId   String    @map("primary_waiter_membership_id") @db.Uuid
  primaryWaiterShiftSessionId String    @map("primary_waiter_shift_session_id") @db.Uuid
  /// DINE_IN | CALL_PICKUP
  sessionKind                 String    @default("DINE_IN") @map("session_kind") @db.VarChar(32)
  customerName                String?   @map("customer_name") @db.VarChar(120)
  customerPhone               String?   @map("customer_phone") @db.VarChar(40)
  guestCount                  Int?      @map("guest_count")
  status                      String    @default("OPEN") @db.VarChar(32)
  openedAt                    DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  billRequestedAt             DateTime? @map("bill_requested_at") @db.Timestamptz(6)
  closedAt                    DateTime? @map("closed_at") @db.Timestamptz(6)
  closedByMembershipId        String?   @map("closed_by_membership_id") @db.Uuid
  idleAlertSentAt             DateTime? @map("idle_alert_sent_at") @db.Timestamptz(6)
  closeReason                 String?   @map("close_reason") @db.Text
  version                     Int       @default(1)
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch        Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table         DiningTable            @relation(fields: [tableId], references: [id], onDelete: Restrict)
  primaryWaiter TenantStaffMembership  @relation("TableSessionWaiter", fields: [primaryWaiterMembershipId], references: [id], onDelete: Restrict)
  waiterShift   ShiftSession           @relation(fields: [primaryWaiterShiftSessionId], references: [id], onDelete: Restrict)
  closedBy      TenantStaffMembership? @relation("TableSessionClosedBy", fields: [closedByMembershipId], references: [id], onDelete: SetNull)
