/// Tenant-editable finance category. `direction` decides whether entries
/// grouped under it count as income or as an expense.
model FinanceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// INCOME | EXPENSE
  direction   String   @db.VarChar(10)
  code        String   @db.VarChar(40)
  name        String   @db.VarChar(120)
  amharicName String?  @map("amharic_name") @db.VarChar(120)
  /// Seeded category; cannot be deleted by tenants.
  isSystem    Boolean  @default(false) @map("is_system")
  sortOrder   Int      @default(0) @map("sort_order")
  /// ACTIVE | INACTIVE
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entries ManualFinanceEntry[]

  @@unique([tenantId, direction, code], map: "uq_finance_categories__tenant_direction_code")
  @@index([tenantId, direction, status], map: "ix_finance_categories__tenant_direction")
  @@map("finance_categories")
}

/// A manually recorded money line — a custom expense or custom income.
/// `label` is free text; `categoryId` is optional (null = uncategorised).
model ManualFinanceEntry {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  branchId              String   @map("branch_id") @db.Uuid
  businessDate          DateTime @map("business_date") @db.Date
  /// INCOME | EXPENSE
  direction             String   @db.VarChar(10)
  categoryId            String?  @map("category_id") @db.Uuid
  /// Free text, e.g. "Floor replacement — back dining area".
  label                 String   @db.VarChar(180)
  amount                Decimal  @db.Decimal(19, 2)
  currencyCode          String   @default("ETB") @map("currency_code") @db.Char(3)
  /// CASH | BANK | TELEBIRR | OTHER
  settledVia            String   @default("CASH") @map("settled_via") @db.VarChar(16)
  /// Payee (expense) or payer (income).
  counterparty          String?  @map("counterparty") @db.VarChar(160)
  note                  String?  @db.VarChar(500)
  receiptFileId         String?  @map("receipt_file_id") @db.Uuid
  /// DRAFT | POSTED | VOID
  status                String   @default("POSTED") @db.VarChar(16)
  createdByMembershipId String   @map("created_by_membership_id") @db.Uuid
  voidedByMembershipId  String?  @map("voided_by_membership_id") @db.Uuid
  voidedAt              DateTime? @map("voided_at") @db.Timestamptz(6)
  voidReason            String?  @map("void_reason") @db.VarChar(300)
  version               Int      @default(1)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch    Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  category  FinanceCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy TenantStaffMembership  @relation("ManualFinanceEntryCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: Restrict)

  @@index([tenantId, branchId, businessDate], map: "ix_manual_finance_entries__branch_date")
  @@index([tenantId, direction, businessDate], map: "ix_manual_finance_entries__tenant_direction_date")
  @@index([tenantId, categoryId], map: "ix_manual_finance_entries__category")
  @@map("manual_finance_entries")
}

