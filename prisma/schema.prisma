  orders        Order[]
  orderItems    OrderItem[]
  billRequests  BillRequest[]
  bill          Bill?
  feedback      CustomerFeedback[]

  @@index([tenantId, branchId, businessDate, openedAt], map: "ix_table_sessions__branch_business_date")
  @@index([branchId, sessionKind, status], map: "ix_table_sessions__branch_session_kind")
  @@map("table_sessions")
}

model TableAssignment {
