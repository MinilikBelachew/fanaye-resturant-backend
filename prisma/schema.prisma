  subtotalAmount           Decimal   @map("subtotal_amount") @db.Decimal(19, 2)
  cancelledAmount          Decimal   @default(0) @map("cancelled_amount") @db.Decimal(19, 2)
  totalAmount              Decimal   @map("total_amount") @db.Decimal(19, 2)
  amountPaid               Decimal   @default(0) @map("amount_paid") @db.Decimal(19, 2)
  generatedByMembershipId  String    @map("generated_by_membership_id") @db.Uuid
