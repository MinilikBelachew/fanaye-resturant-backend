generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File {
  id       String    @id(map: "PK_36b46d232307066b3a2c9ea3a1d") @default(uuid()) @db.Uuid
  path     String    @db.VarChar
  appUsers AppUser[]
  transferReceipts TransferReceipt[]
  menuItems MenuItem[]

  @@map("file")
}

// =============================================================================
// Identity — login is not restaurant access
// =============================================================================

model AppUser {
  id            String    @id @default(uuid()) @db.Uuid
  email         String?   @db.VarChar(255)
  phone         String?   @db.VarChar(32)
  displayName   String    @map("display_name") @db.VarChar(160)
  accountStatus String    @default("ACTIVE") @map("account_status") @db.VarChar(24)
  authProvider  String?   @map("auth_provider") @db.VarChar(40)
  photoId       String?   @unique @map("photo_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  photo          File?              @relation(fields: [photoId], references: [id])
  credential     UserCredential?
  sessions       AuthSession[]
  platformRoles      PlatformUserRole[]
  grantedRoles       PlatformUserRole[] @relation("PlatformRoleGrantedBy")
  tenantEntitlements TenantEntitlement[]
  staffMemberships   TenantStaffMembership[]
  auditEvents        AuditEvent[]
  idempotencyCommands IdempotencyCommand[]
  supportSessions    PlatformSupportSession[]

  @@unique([email], map: "uq_app_users__email")
  @@unique([phone], map: "uq_app_users__phone")
  @@index([accountStatus], map: "ix_app_users__account_status")
  @@map("app_users")
}

model UserCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  authProvider String   @default("email") @map("auth_provider") @db.VarChar(40)
  socialId     String?  @map("social_id") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([socialId, authProvider], map: "ix_user_credentials__social")
  @@map("user_credentials")
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  hash      String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_auth_sessions__user")
  @@map("auth_sessions")
}

model PlatformUserRole {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  roleCode        String    @map("role_code") @db.VarChar(40)
  status          String    @default("ACTIVE") @db.VarChar(20)
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid

  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy AppUser? @relation("PlatformRoleGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, roleCode], map: "uq_platform_user_roles__user_role")
  @@index([userId, status], map: "ix_platform_user_roles__user_status")
  @@map("platform_user_roles")
}

model PlatformSupportSession {
  id             String    @id @default(uuid()) @db.Uuid
  platformUserId String    @map("platform_user_id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  reason         String    @db.Text
  scopeJson      Json      @map("scope_json")
  status         String    @default("ACTIVE") @db.VarChar(20)
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  platformUser AppUser @relation(fields: [platformUserId], references: [id], onDelete: Restrict)
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, startedAt(sort: Desc)], map: "ix_platform_support_sessions__tenant_active")
  @@map("platform_support_sessions")
}

// =============================================================================
// Company / tenancy
// =============================================================================

model SubscriptionPlan {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @db.VarChar(60)
  name      String   @db.VarChar(120)
  status    String   @default("ACTIVE") @db.VarChar(20)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  entitlements   PlanEntitlement[]
  subscriptions  TenantSubscription[]

  @@unique([code, version], map: "uq_subscription_plans__code_version")
  @@map("subscription_plans")
}

model PlanEntitlement {
  id             String   @id @default(uuid()) @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  entitlementKey String   @map("entitlement_key") @db.VarChar(120)
  valueJson      Json     @map("value_json")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, entitlementKey], map: "uq_plan_entitlements__plan_key")
  @@map("plan_entitlements")
}

model Tenant {
  id              String    @id @default(uuid()) @db.Uuid
  displayName     String    @map("display_name") @db.VarChar(180)
  legalName       String?   @map("legal_name") @db.VarChar(220)
  status          String    @db.VarChar(24)
  defaultTimezone String    @map("default_timezone") @db.VarChar(80)
  currencyCode    String    @map("currency_code") @db.Char(3)
  settingsVersion Int       @default(1) @map("settings_version")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  activatedAt     DateTime? @map("activated_at") @db.Timestamptz(6)
  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(6)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)
  version         Int       @default(1)

  settings       TenantSettings?
  subscriptions  TenantSubscription[]
  entitlements      TenantEntitlement[]
  staffMemberships  TenantStaffMembership[]
  branchSettings    BranchSettings[]
  shiftDefinitions  ShiftDefinition[]
  shiftAssignments  ShiftAssignment[]
  shiftSessions     ShiftSession[]
  stations               PreparationStation[]
  menus                  Menu[]
  menuPeriods            MenuPeriod[]
  menuCategories         MenuCategory[]
  menuItems              MenuItem[]
  modifierGroups         ModifierGroup[]
  modifierOptions        ModifierOption[]
  itemModifierAssignments MenuItemModifierAssignment[]
  itemAvailabilityOverrides ItemAvailabilityOverride[]
  stationStaffAssignments StationStaffAssignment[]
  stationFallbacks       StationFallbackConfiguration[]
  branches               Branch[]
  tableLocations    TableLocation[]
  diningTables      DiningTable[]
  diningTableShiftCoverages DiningTableShiftCoverage[]
  tableSessions     TableSession[]
  tableAssignments  TableAssignment[]
  orders            Order[]
  orderItems        OrderItem[]
  orderItemModifiers OrderItemModifier[]
  billRequests      BillRequest[]
  bills             Bill[]
  billLines         BillLine[]
  billReopenRequests BillReopenRequest[]
  payments          Payment[]
  transferReceipts  TransferReceipt[]
  cashierSessions   CashierFinancialSession[]
  cashDrops         CashDrop[]
  cashDropDisputes  CashDropDispute[]
  cashLedgerEntries CashLedgerEntry[]
  cashierReconciliations CashierReconciliation[]
  notifications     Notification[]
  auditEvents       AuditEvent[]
  dailyCloses       OperationalDailyClose[]
  dailyCloseWaiterLines DailyCloseWaiterLine[]
  dailyCloseStationLines DailyCloseStationLine[]
  idempotencyCommands IdempotencyCommand[]
  supportSessions     PlatformSupportSession[]
  orderChangeRequests OrderChangeRequest[]
  cancellationRequests CancellationRequest[]
  productionExceptions ProductionException[]

  @@index([status], map: "ix_tenants__status")
  @@map("tenants")
}

model TenantSettings {
  tenantId                          String   @id @map("tenant_id") @db.Uuid
  defaultShiftGraceMinutes          Int      @default(15) @map("default_shift_grace_minutes")
  waiterMayClosePaidTable           Boolean  @default(true) @map("waiter_may_close_paid_table")
  cashierMayCollectCustomerPayment  Boolean  @default(false) @map("cashier_may_collect_customer_payment")
  protectedCancellationPolicy       String   @default("MANAGER_APPROVAL") @map("protected_cancellation_policy") @db.VarChar(40)
  unresolvedProductionBillPolicy    String   @default("BLOCK") @map("unresolved_production_bill_policy") @db.VarChar(40)
  settingsVersion                   Int      @default(1) @map("settings_version")
  updatedByMembershipId             String?  @map("updated_by_membership_id") @db.Uuid
  updatedAt                         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedByMembership TenantStaffMembership? @relation(fields: [updatedByMembershipId], references: [id], onDelete: SetNull)

  @@map("tenant_settings")
}

model TenantSubscription {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  planId             String    @map("plan_id") @db.Uuid
  subscriptionStatus String    @map("subscription_status") @db.VarChar(24)
  effectiveFrom      DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo        DateTime? @map("effective_to") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  version            Int       @default(1)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, subscriptionStatus], map: "ix_tenant_subscriptions__tenant_status")
  @@map("tenant_subscriptions")
}

model TenantEntitlement {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  entitlementKey String    @map("entitlement_key") @db.VarChar(120)
  valueJson      Json      @map("value_json")
  effectiveFrom  DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime? @map("effective_to") @db.Timestamptz(6)
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  changedBy AppUser? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, entitlementKey], map: "ix_tenant_entitlements__tenant_key")
  @@map("tenant_entitlements")
}

// =============================================================================
// Branch + floor config (staff comes after company)
// =============================================================================

model Branch {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  name              String    @db.VarChar(180)
  displayCode       String?   @map("display_code") @db.VarChar(40)
  timezone          String    @db.VarChar(80)
  status            String    @db.VarChar(20)
  openingTime       DateTime? @map("opening_time") @db.Time(0)
  closingTime       DateTime? @map("closing_time") @db.Time(0)
  businessDayCutoff DateTime  @map("business_day_cutoff") @db.Time(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  version           Int       @default(1)

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  settings         BranchSettings?
  staffAssignments BranchStaffAssignment[]
  roleAssignments  StaffRoleAssignment[]
  shiftDefinitions ShiftDefinition[]
  shiftAssignments ShiftAssignment[]
  shiftSessions    ShiftSession[]
  stations         PreparationStation[]
  menus            Menu[]
  tableLocations   TableLocation[]
  diningTables     DiningTable[]
  diningTableShiftCoverages DiningTableShiftCoverage[]
  tableSessions    TableSession[]
  tableAssignments TableAssignment[]
  orders           Order[]
  orderItems       OrderItem[]
  billRequests     BillRequest[]
  bills            Bill[]
  billReopenRequests BillReopenRequest[]
  payments         Payment[]
  cashierSessions  CashierFinancialSession[]
  cashDrops        CashDrop[]
  cashDropDisputes CashDropDispute[]
  cashLedgerEntries CashLedgerEntry[]
  cashierReconciliations CashierReconciliation[]
  notifications    Notification[]
  auditEvents      AuditEvent[]
  dailyCloses      OperationalDailyClose[]
  orderChangeRequests OrderChangeRequest[]
  cancellationRequests CancellationRequest[]
  productionExceptions ProductionException[]

  @@unique([tenantId, displayCode], map: "uq_branches__tenant_display_code")
  @@index([tenantId, status], map: "ix_branches__tenant_status")
  @@map("branches")
}

model BranchSettings {
  branchId                                String   @id @map("branch_id") @db.Uuid
  tenantId                                String   @map("tenant_id") @db.Uuid
  waiterMayClosePaidTableOverride         Boolean? @map("waiter_may_close_paid_table_override")
  cashierMayCollectCustomerPaymentOverride Boolean? @map("cashier_may_collect_customer_payment_override")
  stationDelayDefaultMinutes              Int?     @map("station_delay_default_minutes")
  shiftEndWarningMinutes                  Int      @default(15) @map("shift_end_warning_minutes")
  billUnresolvedProductionPolicyOverride  String?  @map("bill_unresolved_production_policy_override") @db.VarChar(40)
  settingsVersion                         Int      @default(1) @map("settings_version")
  updatedByMembershipId                   String?  @map("updated_by_membership_id") @db.Uuid
  updatedAt                               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch              Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  updatedByMembership TenantStaffMembership? @relation(fields: [updatedByMembershipId], references: [id], onDelete: SetNull)

  @@map("branch_settings")
}

// =============================================================================
// Staff + restaurant RBAC (login is still app_users; this is restaurant access)
// =============================================================================

model RestaurantRole {
  id       Int     @id @default(autoincrement()) @db.SmallInt
  code     String  @unique @db.VarChar(40)
  name     String  @db.VarChar(80)
  isSystem Boolean @default(true) @map("is_system")

  permissions      RolePermission[]
  staffAssignments StaffRoleAssignment[]
  shiftAssignments ShiftAssignment[]
  shiftSessions    ShiftSession[]

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement()) @db.SmallInt
  code        String  @unique @db.VarChar(100)
  domain      String  @db.VarChar(40)
  description String? @db.Text

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int     @map("role_id") @db.SmallInt
  permissionId Int     @map("permission_id") @db.SmallInt
  allowed      Boolean @default(true)

  role       RestaurantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model TenantStaffMembership {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  employeeDisplayName String    @map("employee_display_name") @db.VarChar(160)
  status              String    @default("ACTIVE") @db.VarChar(20)
  joinedAt            DateTime? @map("joined_at") @db.Timestamptz(6)
  deactivatedAt       DateTime? @map("deactivated_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user               AppUser                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  branchAssignments  BranchStaffAssignment[]
  roleAssignments    StaffRoleAssignment[]
  grantedRoles       StaffRoleAssignment[]   @relation("StaffRoleGrantedBy")
  shiftAssignments        ShiftAssignment[]
  shiftSessions           ShiftSession[]
  stationAssignments      StationStaffAssignment[]
  availabilityOverrides   ItemAvailabilityOverride[]
  createdFallbacks        StationFallbackConfiguration[]
  primaryTableSessions    TableSession[]           @relation("TableSessionWaiter")
  closedTableSessions     TableSession[]           @relation("TableSessionClosedBy")
  tableAssignments        TableAssignment[]        @relation("TableAssignmentWaiter")
  assignedTables          TableAssignment[]        @relation("TableAssignmentAssignedBy")
  createdOrders           Order[]
  cancelledOrderItems     OrderItem[]
  requestedBills          BillRequest[]
  generatedBills          Bill[]               @relation("BillGeneratedBy")
  closedBills             Bill[]               @relation("BillClosedBy")
  billReopenRequests      BillReopenRequest[]  @relation("BillReopenRequestedBy")
  decidedBillReopens      BillReopenRequest[]  @relation("BillReopenDecidedBy")
  collectedPayments       Payment[]
  capturedTransferReceipts TransferReceipt[]
  cashierSessions         CashierFinancialSession[]
  waiterCashDrops         CashDrop[]               @relation("CashDropWaiter")
  receivedCashDrops       CashDrop[]               @relation("CashDropReceivedBy")
  resolvedDisputes        CashDropDispute[]
  createdLedgerEntries    CashLedgerEntry[]
  reviewedReconciliations CashierReconciliation[]
  notifications           Notification[]
  auditEvents             AuditEvent[]
  generatedDailyCloses    OperationalDailyClose[] @relation("DailyCloseGeneratedBy")
  approvedDailyCloses     OperationalDailyClose[] @relation("DailyCloseApprovedBy")
  lockedDailyCloses       OperationalDailyClose[] @relation("DailyCloseLockedBy")
  dailyCloseWaiterLines   DailyCloseWaiterLine[]
  idempotencyCommands     IdempotencyCommand[]
  requestedOrderChanges   OrderChangeRequest[] @relation("OrderChangeRequestedBy")
  decidedOrderChanges     OrderChangeRequest[] @relation("OrderChangeDecidedBy")
  requestedCancellations  CancellationRequest[] @relation("CancellationRequestedBy")
  assignedDiningTables    DiningTable[]        @relation("DiningTableAssignedWaiter")
  shiftTableCoverages     DiningTableShiftCoverage[] @relation("DiningTableShiftCoverageWaiter")
  decidedCancellations    CancellationRequest[] @relation("CancellationDecidedBy")
  reportedExceptions      ProductionException[] @relation("ProductionExceptionReportedBy")
  resolvedExceptions      ProductionException[] @relation("ProductionExceptionResolvedBy")
  updatedTenantSettings TenantSettings[]
  updatedBranchSettings BranchSettings[]

  @@unique([tenantId, userId], map: "uq_tenant_staff_memberships__tenant_user")
  @@index([tenantId, status], map: "ix_tenant_staff_memberships__tenant_status")
  @@map("tenant_staff_memberships")
}

model BranchStaffAssignment {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  branchId           String    @map("branch_id") @db.Uuid
  staffMembershipId  String    @map("staff_membership_id") @db.Uuid
  status             String    @default("ACTIVE") @db.VarChar(20)
  assignedAt         DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  releasedAt         DateTime? @map("released_at") @db.Timestamptz(6)

  branch     Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  membership TenantStaffMembership  @relation(fields: [staffMembershipId], references: [id], onDelete: Restrict)

  @@index([branchId, status], map: "ix_branch_staff_assignments__branch_status")
  @@map("branch_staff_assignments")
}

model StaffRoleAssignment {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  staffMembershipId    String    @map("staff_membership_id") @db.Uuid
  roleId               Int       @map("role_id") @db.SmallInt
  branchId             String?   @map("branch_id") @db.Uuid
  status               String    @default("ACTIVE") @db.VarChar(20)
  grantedByMembershipId String?  @map("granted_by_membership_id") @db.Uuid
  grantedAt            DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)

  membership TenantStaffMembership  @relation(fields: [staffMembershipId], references: [id], onDelete: Restrict)
  role       RestaurantRole         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch     Branch?                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  grantedBy  TenantStaffMembership? @relation("StaffRoleGrantedBy", fields: [grantedByMembershipId], references: [id], onDelete: SetNull)

  @@index([staffMembershipId, status], map: "ix_staff_role_assignments__membership_status")
  @@map("staff_role_assignments")
}

// =============================================================================
// Shifts — clock in before taking a table
// =============================================================================

model ShiftDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  name           String   @db.VarChar(100)
  startLocalTime DateTime @map("start_local_time") @db.Time(0)
  endLocalTime   DateTime @map("end_local_time") @db.Time(0)
  graceMinutes   Int      @default(15) @map("grace_minutes")
  status         String   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch      Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignments ShiftAssignment[]
  tableCoverages DiningTableShiftCoverage[]

  @@index([tenantId, branchId, status], map: "ix_shift_definitions__branch_status")
  @@map("shift_definitions")
}

model ShiftAssignment {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  branchId           String   @map("branch_id") @db.Uuid
  staffMembershipId  String   @map("staff_membership_id") @db.Uuid
  shiftDefinitionId  String?  @map("shift_definition_id") @db.Uuid
  scheduledStartAt   DateTime @map("scheduled_start_at") @db.Timestamptz(6)
  scheduledEndAt     DateTime @map("scheduled_end_at") @db.Timestamptz(6)
  graceMinutes       Int      @default(15) @map("grace_minutes")
  roleId             Int?     @map("role_id") @db.SmallInt
  status             String   @default("SCHEDULED") @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  membership TenantStaffMembership  @relation(fields: [staffMembershipId], references: [id], onDelete: Restrict)
  definition ShiftDefinition?       @relation(fields: [shiftDefinitionId], references: [id], onDelete: SetNull)
  role       RestaurantRole?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  sessions   ShiftSession[]

  @@index([tenantId, branchId, scheduledStartAt], map: "ix_shift_assignments__branch_start")
  @@map("shift_assignments")
}

model ShiftSession {
  id                       String    @id @default(uuid()) @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  branchId                 String    @map("branch_id") @db.Uuid
  shiftAssignmentId        String?   @map("shift_assignment_id") @db.Uuid
