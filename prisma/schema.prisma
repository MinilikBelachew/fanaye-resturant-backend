  receipt   TransferReceipt?

  @@index([tenantId, billId, createdAt], map: "ix_payments__bill")
  @@index([tenantId, branchId, businessDate, collectorMembershipId], map: "ix_payments__collector_business_date")
  @@map("payments")
}

/// Waiter photographs the Telebirr/bank slip. Fanaye verifies later; no third party.
model TransferReceipt {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  paymentId               String   @unique @map("payment_id") @db.Uuid
