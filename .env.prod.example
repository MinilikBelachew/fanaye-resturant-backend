# =============================================================================
# Restaurant Backend — Production Deployment Environment Configuration
# Copy this to .env on the VPS server or set in GitHub Secrets as PROD_ENV_FILE
# =============================================================================

NODE_ENV=production
APP_PORT=3001
BACKEND_PORT=6060
APP_NAME="Restaurant API"
API_PREFIX=backend
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=https://restaurant.learnica.net,https://www.restaurant.learnica.net
BACKEND_DOMAIN=https://restaurant.learnica.net

# Database Configs
DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5439
DATABASE_USERNAME=restaurant_user
DATABASE_PASSWORD=change_me_to_a_strong_password
DATABASE_NAME=restaurant
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=postgresql://restaurant_user:change_me_to_a_strong_password@postgres:5432/restaurant?schema=public

# Storage Driver (local, s3, s3-presigned)
FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=

# Mail Configs (Use real SMTP in production)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_IGNORE_TLS=false
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true
MAIL_DEFAULT_EMAIL=noreply@restaurant.learnica.net
MAIL_DEFAULT_NAME="Restaurant Platform"

# JWT Auth Secrets (Change to strong random values!)
AUTH_JWT_SECRET=change_me_jwt_secret_restaurant_prod
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=change_me_refresh_secret_restaurant_prod
AUTH_REFRESH_TOKEN_EXPIRES_IN=3650d
AUTH_FORGOT_SECRET=change_me_forgot_secret_restaurant_prod
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=change_me_confirm_email_secret_restaurant_prod
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

# OAuth Keys
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_APP_AUDIENCE=[]

# Redis Queue Configs
REDIS_PORT=6382
WORKER_HOST=redis://redis:6379/1
