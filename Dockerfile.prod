# Stage 1: Build & Prisma Generation
FROM node:22.18.0-alpine AS builder

RUN apk add --no-cache bash openssl libc6-compat

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm install --legacy-peer-deps --no-audit --no-fund

COPY . .

# Generate Prisma Client & Build NestJS application
RUN npx prisma generate
RUN npm run build

# Stage 2: Minimal Production Runtime (~150MB)
FROM node:22.18.0-alpine AS runner

RUN apk add --no-cache bash openssl libc6-compat

WORKDIR /usr/src/app

COPY package*.json ./
# Install production dependencies + lightweight migration/seed runtime tools
RUN npm install --omit=dev --legacy-peer-deps --no-audit --no-fund && \
    npm install prisma@^5.22.0 ts-node@10.9.2 tsconfig-paths@4.2.0 typescript@5.9.3 --legacy-peer-deps --no-audit --no-fund

# Copy generated Prisma client, build output, seed, and config files from builder
COPY --from=builder /usr/src/app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /usr/src/app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY --from=builder /usr/src/app/dist ./dist
COPY --from=builder /usr/src/app/prisma ./prisma
COPY tsconfig.json ./

# Copy entrypoint scripts and make them executable
COPY ./wait-for-it.sh /opt/wait-for-it.sh
COPY ./startup.prod.sh /opt/startup.prod.sh
RUN chmod +x /opt/wait-for-it.sh /opt/startup.prod.sh

EXPOSE 3001

CMD ["/opt/startup.prod.sh"]
